{
  "_meta": {
    "source": "Distilled from ASD-STE100 Issue 9 Part 2 (1274 non-approved entries), filtered for software-engineering writing. Transformed subset: SE-conflicting and no-overlap entries removed, SE-context notes added. Not a reproduction of the dictionary.",
    "method": "Pairs ranked by frequency across 239k words of real agent session prose, then hand-triaged: keep (valid substitution in SE prose), override (STE restriction conflicts with SE terminology, not enforced).",
    "tier": "The first 50 'keep' pairs form the injectable prompt tier (/steward dict on)."
  },
  "keep": [
    {"from": "utilize", "to": "use"},
    {"from": "leverage", "to": "use"},
    {"from": "ensure", "to": "make sure"},
    {"from": "verify", "to": "make sure", "note": "keep 'verify' in formal-verification and cryptographic contexts"},
    {"from": "confirm", "to": "make sure"},
    {"from": "facilitate", "to": "help"},
    {"from": "commence", "to": "start"},
    {"from": "initiate", "to": "start"},
    {"from": "terminate", "to": "stop", "note": "keep 'terminate' for process signals (SIGTERM)"},
    {"from": "prior to", "to": "before"},
    {"from": "subsequent to", "to": "after"},
    {"from": "in order to", "to": "to"},
    {"from": "obtain", "to": "get"},
    {"from": "acquire", "to": "get"},
    {"from": "demonstrate", "to": "show"},
    {"from": "indicate", "to": "show"},
    {"from": "regarding", "to": "about"},
    {"from": "concerning", "to": "about"},
    {"from": "additionally", "to": "also"},
    {"from": "furthermore", "to": "also"},
    {"from": "moreover", "to": "also"},
    {"from": "approximately", "to": "about"},
    {"from": "sufficient", "to": "enough"},
    {"from": "insufficient", "to": "not enough"},
    {"from": "attempt", "to": "try"},
    {"from": "assist", "to": "help"},
    {"from": "permit", "to": "let"},
    {"from": "modify", "to": "change"},
    {"from": "alter", "to": "change"},
    {"from": "maintain", "to": "keep", "note": "SE ambiguity: 'maintain' also means ongoing stewardship of code; use 'keep' only for the retain sense"},
    {"from": "usage", "to": "use"},
    {"from": "main", "to": "primary"},
    {"from": "should", "to": "must", "note": "when the statement is binding; RFC-2119 'should' stays when optionality is intended"},
    {"from": "may", "to": "can", "note": "for ability; RFC-2119 'may' stays when permission is intended"},
    {"from": "every", "to": "all"},
    {"from": "identical", "to": "same"},
    {"from": "absent", "to": "missing"},
    {"from": "proper", "to": "correct"},
    {"from": "kind", "to": "type"},
    {"from": "action", "to": "step", "note": "in procedures"},
    {"from": "via", "to": "through"},
    {"from": "whole", "to": "full"},
    {"from": "numerous", "to": "many"},
    {"from": "myriad", "to": "many"},
    {"from": "plethora", "to": "many"},
    {"from": "aforementioned", "to": "this"},
    {"from": "whilst", "to": "while"},
    {"from": "amongst", "to": "among"},
    {"from": "in the event that", "to": "if"},
    {"from": "due to the fact that", "to": "because"}
  ],
  "overrides": [
    {"term": "run", "ste": "operate", "why": "'run the tests' is precise SE"},
    {"term": "build", "ste": "assemble", "why": "build is the SE noun and verb of art"},
    {"term": "call", "ste": "tell", "why": "function calls"},
    {"term": "fix", "ste": "attach", "why": "bug fixes"},
    {"term": "pass/fail", "ste": "go/if", "why": "test outcomes"},
    {"term": "test (v)", "ste": "noun only", "why": "'test the deploy' is standard SE"},
    {"term": "check (v)", "ste": "make sure", "why": "'check the logs' is standard SE"},
    {"term": "execute", "ste": "do", "why": "process execution"},
    {"term": "compile", "ste": "make a list", "why": "compilers"},
    {"term": "return", "ste": "go", "why": "function returns"},
    {"term": "state", "ste": "condition/tell", "why": "program state"},
    {"term": "thread", "ste": "put", "why": "concurrency"},
    {"term": "branch", "ste": "divide", "why": "git branches"},
    {"term": "origin", "ste": "source", "why": "git origin"},
    {"term": "backup", "ste": "emergency", "why": "data backups"},
    {"term": "port", "ste": "left", "why": "network ports"},
    {"term": "swap", "ste": "interchange", "why": "memory swap"},
    {"term": "case", "ste": "condition", "why": "test cases, switch cases"},
    {"term": "job", "ste": "work", "why": "CI jobs"},
    {"term": "log", "ste": "record", "why": "log files"},
    {"term": "save/store/delete", "ste": "keep/keep/erase", "why": "persistence verbs of art"},
    {"term": "load", "ste": "install", "why": "load a module"},
    {"term": "restart", "ste": "start", "why": "restart is a distinct operation"},
    {"term": "trigger", "ste": "cause", "why": "event triggers"},
    {"term": "hook", "ste": "put", "why": "lifecycle hooks"},
    {"term": "register", "ste": "show", "why": "register a handler"},
    {"term": "request", "ste": "tell", "why": "HTTP requests"},
    {"term": "security", "ste": "correctly", "why": "domain noun"},
    {"term": "drift", "ste": "move", "why": "clock/config drift"},
    {"term": "true/false", "ste": "correct/incorrect", "why": "boolean values"},
    {"term": "valid", "ste": "correct", "why": "validation domain"},
    {"term": "key (v/n)", "ste": "refer", "why": "SE keys everywhere; see bare-key register rule instead"}
  ]
}
